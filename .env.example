# Pastas (caminhos relativos ao projeto por padrão, mas customizáveis)
KNOWLEDGE_PATH=./knowledge
CHROMA_PATH=./vector_db
SQL_SCRIPTS_PATH=./knowledge/sql_scripts

# Chave da API do Claude (https://platform.claude.com). Cole só no seu .env local.
# Nunca coloque a chave no código, no README ou no GitHub.
ANTHROPIC_API_KEY=

# Opcionais
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium        # low | medium | high | xhigh | max
# RAG_TOP_K=4                 # quantos trechos a busca envia ao Claude
